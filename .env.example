# ── 나무증권(NH투자증권) Open API (https://www.nhplug.com 에서 앱키 발급)
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
# 계좌번호: `python -m trading_bot accounts` 로 확인 (모의투자는 03 계좌)
NHPLUG_ACCOUNT=
# paper = 모의투자, real = 실전 (실전은 BOT_ARGS 에 --confirm-real 도 필요)
NHPLUG_MODE=paper
NHPLUG_DOMAIN=nhplug.com

# ── 텔레그램 (휴대폰 알림/제어)
# @BotFather 에서 봇 만들고 받은 토큰
TELEGRAM_BOT_TOKEN=
# `python -m trading_bot telegram-setup` 으로 확인
TELEGRAM_CHAT_ID=

# ── 봇 실행 옵션 (서버 서비스가 사용)
BOT_ARGS=--symbols 005930 000660 --strategy sma_flow --max-position 0.2 --stop-loss 0.07 --max-daily-loss 0.03

# ── 한국투자증권 (선택, --api kis)
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT=12345678-01
# KIS_MODE=paper
