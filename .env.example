# ── 나무증권(NH투자증권) Open API — 기본 (https://www.nhplug.com 에서 앱키 발급)
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
# 계좌번호: `python -m trading_bot accounts` 로 확인 (모의투자는 acct_type 03 계좌)
NHPLUG_ACCOUNT=
# paper = 모의투자(moapi), real = 운영(실제 주문 체결)
NHPLUG_MODE=paper
# 나무 = nhplug.com, N2 = n2plug.com
NHPLUG_DOMAIN=nhplug.com

# ── 한국투자증권 Open API — 선택 (--api kis 로 사용)
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT=12345678-01
# KIS_MODE=paper
